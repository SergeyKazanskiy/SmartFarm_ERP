{
    "module": {
      "name": "Sales — продажи и коммерческая деятельность",
      "version": "1.0",
      "scope": "Управление продажами: коммерческие предложения, заказы клиентов, отгрузки, возвраты, ценообразование, работа с клиентами. Интегрируется с WMS (отгрузка готовой продукции), Production (заказы на производство), Finance (выставление счетов, оплаты).",
      "notes": [
        "sales_customer — справочник клиентов (контрагенты с доп. полями)",
        "sales_opportunity — воронка продаж (лиды → переговоры → закрыто)",
        "sales_quote — коммерческое предложение клиенту",
        "sales_order — заказ клиента (входной заказ)",
        "sales_order_line — позиции заказа (товар, цена, количество)",
        "sales_shipment — отгрузка товара клиенту (интеграция с WMS)",
        "sales_shipment_line — позиции отгрузки",
        "sales_return — возврат товара от клиента",
        "sales_return_line — позиции возврата",
        "sales_invoice — счет на оплату (интеграция с Finance)",
        "sales_price_list — прайс-листы и цены",
        "sales_price_list_line — цены на товары в прайс-листе"
      ]
    },
